#include <windows.h>
#include "game.h"
1 RT_MANIFEST "setup.manifest"
GAMEEXE RCDATA "../build/release/game.exe"
#ifdef SETUP_ICON
1 ICON "../build/game.ico"
#endif

/* version info: without it Windows Defender's machine-learning check may flag
   the setup as a trojan (false positive, seen on A Final Unity's first build) */
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PC Native fan port"
            VALUE "FileDescription", GAME_TITLE " PC Native - Setup"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "setup"
            VALUE "LegalCopyright", "Port code: open source. Game: its owners."
            VALUE "OriginalFilename", "setup.exe"
            VALUE "ProductName", GAME_TITLE " PC Native"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
