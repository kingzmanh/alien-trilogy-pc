#include <windows.h>
#include "game.h"
1 ICON "game.ico"

/* version info (see installer/setup.rc: avoids Defender machine-learning false positives) */
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PC Native fan port"
            VALUE "FileDescription", GAME_TITLE " PC Native"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", GAME_SHORT
            VALUE "LegalCopyright", "Port code: open source. Game: its owners."
            VALUE "OriginalFilename", GAME_SHORT ".exe"
            VALUE "ProductName", GAME_TITLE " PC Native"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
